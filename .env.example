MONGODB_URI=mongodb://127.0.0.1:27017/rpg_chess
CHESS_AUTH_SECRET=replace-with-a-long-random-secret
# Optional: the previous secret during a rotation. Guests signed with it stay
# signed in and are re-issued a cookie signed with CHESS_AUTH_SECRET.
# CHESS_AUTH_SECRET_PREVIOUS=
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
# Optional DNS override for SRV connections; leave unset to preserve defaults.
# MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1
# Tests provision isolated MongoDB automatically and use port 3100 for browsers.
# SIM_GAMES=1000  # Optional local harness override; delivery measurement is 1000.
