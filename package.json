{
  "name": "chess-game",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "simulate": "tsx scripts/simulate-balance.ts",
    "measure:ai": "tsx scripts/measure-ai.ts",
    "playtest": "tsx scripts/playtest.ts",
    "backfill:match-expiry": "tsx scripts/backfill-match-expiry.ts",
    "format:check": "prettier --check \"app/**/*.{ts,tsx}\" \"models/**/*.ts\" \"lib/**/*.ts\" \"hooks/**/*.ts\" \"components/**/*.tsx\" \"tests/**/*.ts\" \"scripts/**/*.ts\""
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "mongoose": "^8.24.5",
    "next": "^15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.28",
    "mongodb-memory-server": "^11.3.0",
    "postcss": "^8",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
